rule bloodhound_remote_security_configuration_value_reads {
  meta:
    author = "Detection Research Agent"
    description = "Detects reads of two or more named security-relevant registry values (certificate binding, NTLM restriction, LDAP channel binding/signing, certificate mapping) from a single source, compensating for single-target reads that stay below bloodhound_remote_security_configuration_reads's multi-host threshold."
    date = "2026-08-16"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Named-value specificity confirms security-configuration reconnaissance even against one high-value target such as a single CA or DC."
    procedure_ids = "BH-012"
    log_source_prerequisites = "EDR REGISTRY_READ or scoped 4656/4663 with full registry key AND value name, source and target host."
    false_positives = "Security posture assessment, PKI administration and domain-controller compliance tools reading multiple settings on one host."
    references = "reports/bloodhound/source-analysis.md, public-rules/comparisons/bloodhound/bloodhound_remote_security_configuration_reads.md"
    validation_status = "needs_validation"
    validation_method = "Use sanitized sensitive-value reads and approved posture-scanner negatives against a single target."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/bloodhound/detection-review.md"
  events:
    $e.metadata.product_event_type = /(REGISTRY_READ|4656|4663)/
    $e.principal.hostname = $source
    $e.target.hostname = $target
    re.regex($e.target.registry.registry_key, `(?i)(CertSvc\\Configuration|Netlogon\\Parameters|Lsa\\MSV1_0|NTDS\\Parameters)`)
    re.regex($e.target.registry.registry_value_name, `(?i)(StrongCertificateBindingEnforcement|CertificateMappingMethods|RestrictNTLM|LDAPServerIntegrity|LdapEnforceChannelBinding)`)
    $e.target.registry.registry_value_name = $value
  match:
    $source over 30m
  outcome:
    $values = count_distinct($value)
  condition:
    $e and $values >= 2
}
