rule bloodhound_graph_deep_relationship_enumeration {
  meta:
    author = "Detection Research Agent"
    description = "Detects one Graph principal or application enumerating a high volume of relationship-bearing objects (memberOf, owners, appRoleAssignments, transitiveMembers) within a single resource family, compensating for attackers who avoid multi-family fanout captured by bloodhound_azure_graph_enumeration_fanout."
    date = "2026-08-16"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Deep single-family relationship enumeration exposes group/role membership attack paths as effectively as multi-family fanout."
    procedure_ids = "BH-017"
    log_source_prerequisites = "MicrosoftGraphActivityLogs with principal user ID, application/service-principal ID, HTTP method, request URL and resolved target object identity."
    false_positives = "Identity governance, synchronization, compliance and cloud security posture tools performing legitimate relationship enumeration."
    references = "reports/bloodhound/source-analysis.md, public-rules/comparisons/bloodhound/bloodhound_azure_graph_enumeration_fanout.md"
    validation_status = "needs_validation"
    validation_method = "Test approved sync/governance apps and sanitized single-family deep-pagination fixtures."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/bloodhound/detection-review.md"
  events:
    $e.metadata.product_event_type = "MicrosoftGraphActivityLogs"
    $e.principal.user.userid = $principal
    $e.principal.application = $app
    $e.network.http.method = "GET"
    re.regex($e.target.url, `(?i)/(users|groups|servicePrincipals|applications)/.*(memberOf|owners|appRoleAssignments|transitiveMembers)`)
    $e.target.resource.name = $object
  match:
    $principal, $app over 30m
  outcome:
    $objects = count_distinct($object)
  condition:
    $e and $objects >= 100
}
