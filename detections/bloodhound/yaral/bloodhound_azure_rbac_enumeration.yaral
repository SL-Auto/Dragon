rule bloodhound_azure_rbac_enumeration {
  meta:
    author = "Detection Research Agent"
    description = "Detects high-cardinality Azure RBAC, owner, access-policy or role-eligibility reads."
    date = "2026-08-15"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Privilege relationship discovery directly reveals exploitable cloud authorization paths."
    procedure_ids = "BH-019"
    log_source_prerequisites = "Graph/ARM audit with principal, operation name, target scope/object and source."
    false_positives = "Access reviews, IAM governance, CSPM and authorized audits."
    references = "reports/bloodhound/source-analysis.md"
    validation_status = "needs_validation"
    validation_method = "Test bounded IAM administration against multi-scope enumeration fixtures."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/bloodhound/detection-review.md"
  events:
    $e.metadata.product_event_type = /(MicrosoftGraphActivityLogs|AzureActivity|AZURE_RESOURCE_READ)/
    $e.principal.user.userid = $principal
    re.regex($e.target.resource.attribute.labels["operation"], `(?i)(roleAssignments|roleDefinitions|owners|accessPolicies|eligibility)`) 
    $e.target.resource.name = $scope
  match:
    $principal over 30m
  outcome:
    $scopes = count_distinct($scope)
  condition:
    $e and $scopes >= 10
}
