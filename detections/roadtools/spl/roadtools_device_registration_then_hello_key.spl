# source_yaral: detections/roadtools/yaral/roadtools_device_registration_then_hello_key.yaral
# translation_status: experimental_needs_backend_mapping_and_validation
# fidelity: partial
# rule_name: roadtools_device_registration_then_hello_key
# severity: medium
# procedure_ids: RT-P03,RT-P05
# description: Detects a device registration by a user followed within 1 hour by a Windows Hello for Business key or passkey being added to that user, the persistence sequence of registering an attacker device and binding a key to it.
# log_source_prerequisites: Entra ID audit logs (AuditLogs) normalized with activityDisplayName in metadata.product_event_type, initiating user in principal.user.userid, target user or device in target.user.userid or target.resource.name, and modified-property values in additional.fields['modifiedProperties'].
# false_positives: Legitimate new-device enrollment with Windows Hello provisioning.
# references: reports/roadtools/source-analysis.md#procedure-analysis; reviews/roadtools/detection-review.md
# assumptions_and_gaps: Candidate retrieval is translated; canonical entity joins, ordering, windows, and cardinality must be implemented and tested in the target backend.
# schema_profile: schemas/splunk-cim.yml
index=<configured_index>
| where in(coalesce('metadata.product_event_type','metadata.event_type'), "Add device", "FIDO2", "passkey", "Register device", "security info", "security key")
| eval canonical_rule="roadtools_device_registration_then_hello_key"
| stats count values('metadata.product_event_type') as observed_event_types by 'principal.hostname', 'principal.user.userid'
| where count > 0
