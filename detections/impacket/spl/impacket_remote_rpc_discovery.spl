# source_yaral: detections/impacket/yaral/impacket_remote_rpc_discovery.yaral
# translation_status: experimental_needs_backend_mapping_and_validation
# fidelity: partial
# rule_name: impacket_remote_rpc_discovery
# severity: medium
# procedure_ids: IMP-08,IMP-16
# description: Detects unusual remote RPC interface enumeration and discovery volume.
# log_source_prerequisites: RPC-aware network or ETW telemetry with source, target and interface UUID.
# false_positives: Inventory, vulnerability scanning and management systems.
# references: reports/impacket/source-analysis.md, reviews/impacket/detection-review.md#review-015
# assumptions_and_gaps: Candidate retrieval is translated; canonical entity joins, ordering, windows, and cardinality must be implemented and tested in the target backend.
# schema_profile: schemas/splunk-cim.yml
index=<configured_index>
| where in(coalesce('metadata.product_event_type','metadata.event_type'), "NETWORK_CONNECTION")
| eval canonical_rule="impacket_remote_rpc_discovery"
| stats count values('metadata.product_event_type') as observed_event_types by 'principal.hostname', 'principal.user.userid'
| where count > 0
