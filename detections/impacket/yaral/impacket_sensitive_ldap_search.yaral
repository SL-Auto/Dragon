rule impacket_sensitive_ldap_search {
 meta:
  author = "Detection Research Agent"
  description = "Detects LDAP searches for sensitive credential or delegation attributes."
  date = "2026-08-15"
  status = "experimental"
  severity = "MEDIUM"
  severity_rationale = "Sensitive directory enumeration supports credential access and privilege mapping."
  procedure_ids = "IMP-09"
  log_source_prerequisites = "LDAP diagnostic 1644 or directory audit preserving filter and requested attributes."
  false_positives = "Identity governance, AD health and security assessment."
  references = "reports/impacket/source-analysis.md"
  validation_status = "needs_validation"
  review_status = "reviewed_with_gaps"
  review_reference = "reviews/impacket/detection-review.md"
 events:
  $e.metadata.product_event_type = "1644"
  re.regex($e.additional.fields["filter"], `(?i)(ms-Mcs-AdmPwd|msLAPS-Password|msDS-AllowedToActOnBehalfOfOtherIdentity|servicePrincipalName|userAccountControl)`)
 condition: $e
}
