rule impacket_wmi_subscription_change {
 meta:
  author = "Detection Research Agent"
  description = "Detects WMI filter, consumer or binding creation."
  date = "2026-08-15"
  status = "experimental"
  severity = "HIGH"
  severity_rationale = "Permanent WMI subscriptions provide persistence."
  procedure_ids = "IMP-06"
  log_source_prerequisites = "Sysmon 19-21 or equivalent WMI repository events."
  false_positives = "Approved monitoring and management products."
  references = "reports/impacket/source-analysis.md"
  validation_status = "needs_validation"
  review_status = "reviewed_with_gaps"
  review_reference = "reviews/impacket/detection-review.md"
 events:
  $e.metadata.product_event_type = /(19|20|21|5861)/
 condition: $e
}
