rule impacket_privilege_path_effects {
 meta:
  author = "Detection Research Agent"
  description = "Detects correlated directory privilege changes and anomalous Kerberos ticket use."
  date = "2026-08-15"
  status = "experimental"
  severity = "HIGH"
  severity_rationale = "Combined authorization and ticket anomalies can expose privilege escalation."
  procedure_ids = "IMP-22"
  log_source_prerequisites = "DC directory-change and Kerberos events with actor, target and source."
  false_positives = "Approved domain migrations and delegation changes."
  references = "reports/impacket/source-analysis.md"
  validation_status = "needs_validation"
  review_status = "reviewed_with_gaps"
  review_reference = "reviews/impacket/detection-review.md"
 events:
  $d.metadata.product_event_type = /(5136|5137|4741|4742)/
  $d.principal.user.userid = $user
  $k.metadata.product_event_type = /(4768|4769)/
  $k.principal.user.userid = $user
 match: $user over 15m
 condition: $d and $k
}
