rule impacket_remote_rpc_discovery {
 meta:
  author = "Detection Research Agent"
  description = "Detects unusual remote RPC interface enumeration and discovery volume."
  date = "2026-11-21"
  status = "experimental"
  severity = "MEDIUM"
  severity_rationale = "Broad RPC discovery can precede remote administration or attack."
  procedure_ids = "IMP-08,IMP-16"
  log_source_prerequisites = "RPC-aware network or ETW telemetry with source, target and interface UUID."
  false_positives = "Inventory, vulnerability scanning and management systems."
  references = "reports/impacket/source-analysis.md, reviews/impacket/detection-review.md#review-015"
  validation_status = "needs_validation"
  review_status = "reviewed_with_gaps"
  review_reference = "reviews/impacket/detection-review.md"
 events:
  $e.metadata.event_type = "NETWORK_CONNECTION"
  ($e.target.port = 135 or $e.target.port = 445)
  $e.principal.ip = $src
  $e.target.ip = $dst
 match: $src, $dst over 5m
 condition: #e > 20
}
