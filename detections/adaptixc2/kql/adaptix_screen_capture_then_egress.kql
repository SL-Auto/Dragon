// source_yaral: detections/adaptixc2/yaral/adaptix_screen_capture_then_egress.yaral
// translation_status: experimental_needs_backend_mapping_and_validation
// fidelity: partial
// rule_name: adaptix_screen_capture_then_egress
// severity: medium
// procedure_ids: AX-P10
// description: Detects an EDR screen-capture event in an unverified process that also makes outbound connections within 10 minutes, the Gopher screenshot command.
// log_source_prerequisites: EDR screen-capture telemetry (vendor event normalized as SCREEN_CAPTURE) plus process-attributed NETWORK_CONNECTION.
// false_positives: Screen-sharing, recording and remote-support tools.
// references: reports/adaptixc2/source-analysis.md#procedure-analysis; reviews/adaptixc2/detection-review.md
// assumptions_and_gaps: Candidate retrieval is translated; canonical entity joins, ordering, windows, and cardinality must be implemented and tested in the target backend.
// schema_profile: schemas/sentinel-asim.yml
NormalizedEvents
| where ProductEventType in ("NETWORK_CONNECTION", "SCREEN_CAPTURE") or EventType in ("NETWORK_CONNECTION", "SCREEN_CAPTURE")
| summarize EventCount=count(), ObservedEventTypes=make_set(ProductEventType) by Hostname, UserId
| where EventCount > 0
| extend CanonicalRule="adaptix_screen_capture_then_egress"
