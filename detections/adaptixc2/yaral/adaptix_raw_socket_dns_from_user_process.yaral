rule adaptix_raw_socket_dns_from_user_process {
  meta:
    author = "Detection Research Agent"
    description = "Detects a user-mode process other than the Windows DNS Client sending recurrent UDP/53 traffic directly to a resolver (six or more connections across four or more minutes within 30 minutes). This is the raw-socket DNS transport, which bypasses the DNS Client service and Sysmon DNS query logging."
    date = "2026-11-21"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "On Windows, name resolution is performed by the DNS Client service (svchost); a user process sending its own DNS packets repeatedly is a covert-channel indicator independent of domain names."
    procedure_ids = "AX-P02"
    log_source_prerequisites = "Process-attributed NETWORK_CONNECTION telemetry (Sysmon Event ID 3 or EDR) with direction, protocol, destination IP and port, host and stable process ID; optional signature verification status. UDP must be logged."
    false_positives = "Security agents, VPN clients and browsers with built-in DNS-over-UDP resolvers; approve by signer."
    references = "reports/adaptixc2/source-analysis.md#procedure-analysis; reviews/adaptixc2/detection-review.md"
    validation_status = "needs_validation"
    validation_method = "Replay sanitized UDP/53 events from a non-svchost process over several minutes; confirm the sensor logs UDP."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/adaptixc2/detection-review.md"
  events:
    $e.metadata.event_type = "NETWORK_CONNECTION"
    $e.target.port = 53
    $e.network.ip_protocol = "UDP"
    $e.principal.hostname = $host
    $e.principal.process.product_specific_process_id = $pid
    not re.regex($e.principal.process.file.full_path, `(?i)\\windows\\system32\\(svchost|dns|lsass)\.exe$`)
    $e.principal.process.file.signature_info.verification_status != "VERIFIED"
  match:
    $host, $pid over 30m
  outcome:
    $connections = count($e.metadata.id)
    $active_minutes = count_distinct(timestamp.get_minute($e.metadata.event_timestamp.seconds))
    $resolvers = array_distinct($e.target.ip)
    $process = array_distinct($e.principal.process.file.full_path)
  condition:
    $e and $connections >= 6 and $active_minutes >= 4
}
