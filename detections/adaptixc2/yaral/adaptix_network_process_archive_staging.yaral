rule adaptix_network_process_archive_staging {
  meta:
    author = "Detection Research Agent"
    description = "Detects an unverified process with outbound connections creating a .zip archive within 15 minutes, the Gopher zip-then-download staging pattern."
    date = "2026-11-21"
    status = "experimental"
    severity = "MEDIUM"
    severity_rationale = "Archive creation by an unsigned network process precedes exfiltration; archivers and updaters overlap."
    procedure_ids = "AX-P07"
    log_source_prerequisites = "Process-attributed NETWORK_CONNECTION telemetry (Sysmon Event ID 3 or EDR) with direction, protocol, destination IP and port, host and stable process ID; optional signature verification status. FILE_CREATION (Sysmon Event ID 11) with path and creating process."
    false_positives = "Unsigned archivers, backup tools and updaters."
    references = "reports/adaptixc2/source-analysis.md#procedure-analysis; reviews/adaptixc2/detection-review.md"
    validation_status = "needs_validation"
    validation_method = "Replay sanitized egress plus .zip creation by one process."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/adaptixc2/detection-review.md"
  events:
    $f.metadata.event_type = "FILE_CREATION"
    re.regex($f.target.file.full_path, `(?i)\.zip$`)
    $f.principal.hostname = $host
    $f.principal.process.product_specific_process_id = $pid
    $f.principal.process.file.signature_info.verification_status != "VERIFIED"

    $n.metadata.event_type = "NETWORK_CONNECTION"
    $n.network.direction = "OUTBOUND"
    $n.principal.hostname = $host
    $n.principal.process.product_specific_process_id = $pid
  match:
    $host, $pid over 15m
  outcome:
    $archives = array_distinct($f.target.file.full_path)
  condition:
    $f and $n
}
