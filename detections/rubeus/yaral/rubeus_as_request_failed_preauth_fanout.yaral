rule rubeus_as_request_failed_preauth_fanout {
  meta:
    author = "Detection Research Agent"
    description = "Detects one source generating failed or atypical-result AS requests against multiple accounts, distinct from the existing successful multi-principal fan-out rule."
    date = "2026-08-16"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Non-success AS-REQ fan-out across multiple principals is closely associated with authentication/preauthentication probing rather than a single account's ordinary failed logon."
    procedure_ids = "PROC-001"
    log_source_prerequisites = "Normalize DC Security 4768 with source IP, target account, and a normalized security_result.action or result-code field distinguishing non-success outcomes."
    false_positives = "Password audits, account-lockout/health monitoring tooling, and misconfigured legacy clients retrying stale credentials."
    references = "RUBEUS_SOURCE_DETECTION_DEEP_DIVE.md; public-rules/comparisons/rubeus/rubeus_as_request_anomaly.md"
    validation_status = "needs_validation"
    validation_method = "Verify the parser's security_result.action / 4768 Result Code mapping with sanitized fixtures covering bad-password, preauthentication-required, and clock-skew outcomes before enabling; replay benign password-audit fixtures to confirm the three-account threshold does not over-fire. If the parser does not populate security_result.action for 4768, this rule stays silent (false-negative-safe) rather than mis-firing."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/rubeus/detection-review.md"
  events:
    $e.metadata.product_event_type = "4768"
    $e.security_result.action != "ALLOW"
    $e.principal.ip = $source
    $e.target.user.userid = $account
  match:
    $source over 10m
  outcome:
    $accounts = count_distinct($account)
  condition:
    $e and $accounts >= 3
}
