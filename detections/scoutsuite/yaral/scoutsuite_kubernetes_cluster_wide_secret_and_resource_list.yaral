rule scoutsuite_kubernetes_cluster_wide_secret_and_resource_list {
  meta:
    author = "Detection Research Agent"
    description = "Detects one Kubernetes identity listing Secrets cluster-wide together with ten or more other resource kinds within 10 minutes, the dynamic full-cluster listing that ScoutSuite performs."
    date = "2026-11-21"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Cluster-wide Secret listing returns secret data; combined with broad resource discovery it indicates an audit or enumeration tool rather than a controller."
    procedure_ids = "SS-P04"
    log_source_prerequisites = "Kubernetes API audit logs (EKS, AKS or GKE control-plane logging) normalized with verb and resource in metadata.product_event_type (for example list secrets), user in principal.user.userid and resource kind in additional.fields['resource']."
    false_positives = "Backup operators (Velero), GitOps controllers and cluster-wide security scanners."
    references = "reports/scoutsuite/source-analysis.md#procedure-analysis; reviews/scoutsuite/detection-review.md"
    validation_status = "needs_validation"
    validation_method = "Replay sanitized audit entries listing secrets and ten resource kinds by one user."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/scoutsuite/detection-review.md"
  events:
    re.regex($e.metadata.product_event_type, `(?i)^list`)
    $e.principal.user.userid = $user
    $e.additional.fields["resource"] = $kind
  match:
    $user over 10m
  outcome:
    $kinds = count_distinct($kind)
    $secret_lists = max(if($e.additional.fields["resource"] = "secrets", 1, 0))
  condition:
    $e and $kinds >= 11 and $secret_lists > 0
}
