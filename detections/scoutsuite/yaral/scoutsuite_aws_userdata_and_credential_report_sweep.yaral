rule scoutsuite_aws_userdata_and_credential_report_sweep {
  meta:
    author = "Detection Research Agent"
    description = "Detects one AWS principal reading EC2 user data for three or more instances and generating or retrieving the IAM credential report within 30 minutes, the secret-bearing reads of a ScoutSuite AWS audit."
    date = "2026-11-21"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Combining bulk user-data reads with the credential report collects embedded secrets and the account's credential hygiene in one session."
    procedure_ids = "SS-P01"
    log_source_prerequisites = "AWS CloudTrail management events with eventName in metadata.product_event_type, requestParameters.attribute in additional.fields['attribute'], instanceId in target.resource.name and userIdentity ARN in principal.user.userid."
    false_positives = "Posture tooling and auditors."
    references = "reports/scoutsuite/source-analysis.md#procedure-analysis; reviews/scoutsuite/detection-review.md"
    validation_status = "needs_validation"
    validation_method = "Replay sanitized userData reads for three instances plus credential-report events from one ARN."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/scoutsuite/detection-review.md"
  events:
    $u.metadata.product_event_type = "DescribeInstanceAttribute"
    re.regex($u.additional.fields["attribute"], `(?i)^userData$`)
    $u.principal.user.userid = $principal
    $u.target.resource.name = $instance

    $c.metadata.product_event_type = /^(GenerateCredentialReport|GetCredentialReport)$/
    $c.principal.user.userid = $principal
  match:
    $principal over 30m
  outcome:
    $instances = count_distinct($instance)
  condition:
    $u and $c and $instances >= 3
}
