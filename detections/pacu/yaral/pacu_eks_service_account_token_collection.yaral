rule pacu_eks_service_account_token_collection {
  meta:
    author = "Detection Research Agent"
    description = "Detects one identity reading Kubernetes service-account tokens or secrets across three or more namespaces within 30 minutes in EKS audit logs."
    date = "2026-11-21"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Cross-namespace token and secret reads by one identity harvest workload credentials."
    procedure_ids = "PA-P15"
    log_source_prerequisites = "EKS control-plane audit logs normalized with verb and resource in metadata.product_event_type (for example get secrets, create serviceaccounts/token), user in principal.user.userid and namespace in target.namespace."
    false_positives = "Cluster administrators and secret-sync controllers."
    references = "reports/pacu/source-analysis.md#procedure-analysis; reviews/pacu/detection-review.md"
    validation_status = "needs_validation"
    validation_method = "Replay sanitized EKS audit events across three namespaces; confirm audit logging is enabled."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/pacu/detection-review.md"
  events:
    re.regex($e.metadata.product_event_type, `(?i)(get|list|watch|create).*(secrets|serviceaccounts/token)`)
    $e.principal.user.userid = $user
    $e.target.namespace = $namespace
  match:
    $user over 30m
  outcome:
    $namespaces = count_distinct($namespace)
  condition:
    $e and $namespaces >= 3
}
