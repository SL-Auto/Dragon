rule pacu_iam_privilege_modification_burst {
  meta:
    author = "Detection Research Agent"
    description = "Detects one principal performing two or more distinct IAM privilege-modifying actions within 30 minutes: policy attachment, inline policy, default policy version, group membership or trust-policy change."
    date = "2026-11-21"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Escalation chains combine several IAM modifications quickly; routine administration usually performs one change at a time through infrastructure as code."
    procedure_ids = "PA-P03,PA-P04"
    log_source_prerequisites = "AWS CloudTrail management events normalized with metadata.product_name = 'AWS CloudTrail', eventName in metadata.product_event_type, userIdentity ARN in principal.user.userid, userAgent in network.http.user_agent and requestParameters in additional.fields."
    false_positives = "Infrastructure-as-code pipelines and identity administrators applying multi-step changes; approve deployment role ARNs."
    references = "reports/pacu/source-analysis.md#procedure-analysis; reviews/pacu/detection-review.md"
    validation_status = "needs_validation"
    validation_method = "Replay sanitized IAM write events of two kinds from one ARN; baseline pipeline roles."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/pacu/detection-review.md"
  events:
    $e.metadata.product_name = "AWS CloudTrail"
    $e.metadata.product_event_type = /^(AttachUserPolicy|AttachRolePolicy|AttachGroupPolicy|PutUserPolicy|PutRolePolicy|PutGroupPolicy|CreatePolicyVersion|SetDefaultPolicyVersion|AddUserToGroup|UpdateAssumeRolePolicy)$/
    $e.principal.user.userid = $principal
    $e.metadata.product_event_type = $action
  match:
    $principal over 30m
  outcome:
    $kinds = count_distinct($action)
    $actions = array_distinct($action)
  condition:
    $e and $kinds >= 2
}
