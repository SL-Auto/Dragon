rule pacu_service_credential_issuance {
  meta:
    author = "Detection Research Agent"
    description = "Detects one principal issuing service access credentials of two or more kinds within 30 minutes: Lightsail key pairs or temporary SSH access, or API Gateway API keys."
    date = "2026-11-21"
    status = "experimental"
    severity = "MEDIUM"
    severity_rationale = "Several kinds of service credential in one window indicate access-path creation rather than routine use."
    procedure_ids = "PA-P06"
    log_source_prerequisites = "AWS CloudTrail management events normalized with metadata.product_name = 'AWS CloudTrail', eventName in metadata.product_event_type, userIdentity ARN in principal.user.userid, userAgent in network.http.user_agent and requestParameters in additional.fields."
    false_positives = "Lightsail administrators and API publishers."
    references = "reports/pacu/source-analysis.md#procedure-analysis; reviews/pacu/detection-review.md"
    validation_status = "needs_validation"
    validation_method = "Replay sanitized events of two kinds from one ARN."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/pacu/detection-review.md"
  events:
    $e.metadata.product_name = "AWS CloudTrail"
    $e.metadata.product_event_type = /^(CreateKeyPair|ImportKeyPair|GetInstanceAccessDetails|CreateApiKey)$/
    re.regex($e.target.application, `(?i)(lightsail|apigateway)`)
    $e.principal.user.userid = $principal
    $e.metadata.product_event_type = $kind
  match:
    $principal over 30m
  outcome:
    $kinds = count_distinct($kind)
  condition:
    $e and $kinds >= 2
}
