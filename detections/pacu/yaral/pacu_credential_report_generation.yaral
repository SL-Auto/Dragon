rule pacu_credential_report_generation {
  meta:
    author = "Detection Research Agent"
    description = "Detects generation and retrieval of the IAM credential report (GenerateCredentialReport followed by GetCredentialReport) by a non-console principal."
    date = "2026-11-21"
    status = "experimental"
    severity = "MEDIUM"
    severity_rationale = "The report lists every user's password, key and MFA state, which is useful for selecting targets; audit tools also retrieve it."
    procedure_ids = "PA-P02"
    log_source_prerequisites = "AWS CloudTrail management events normalized with metadata.product_name = 'AWS CloudTrail', eventName in metadata.product_event_type, userIdentity ARN in principal.user.userid, userAgent in network.http.user_agent and requestParameters in additional.fields."
    false_positives = "Compliance and audit tooling."
    references = "reports/pacu/source-analysis.md#procedure-analysis; reviews/pacu/detection-review.md"
    validation_status = "needs_validation"
    validation_method = "Replay sanitized Generate and Get credential-report events."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/pacu/detection-review.md"
  events:
    $g.metadata.product_name = "AWS CloudTrail"
    $g.metadata.product_event_type = "GenerateCredentialReport"
    not re.regex($g.network.http.user_agent, `(?i)(console\.amazonaws\.com|AWS Internal)`)
    $g.principal.user.userid = $principal

    $r.metadata.product_name = "AWS CloudTrail"
    $r.metadata.product_event_type = "GetCredentialReport"
    $r.principal.user.userid = $principal
  match:
    $principal over 30m
  outcome:
    $user_agents = array_distinct($g.network.http.user_agent)
  condition:
    $g and $r
}
