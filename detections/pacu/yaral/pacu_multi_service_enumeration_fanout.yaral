rule pacu_multi_service_enumeration_fanout {
  meta:
    author = "Detection Research Agent"
    description = "Detects one non-console AWS principal issuing List, Describe or Get calls to fifteen or more distinct services within 30 minutes, the breadth of Pacu's enumeration modules."
    date = "2026-11-21"
    status = "experimental"
    severity = "MEDIUM"
    severity_rationale = "Automated enumeration sweeps many services; posture and inventory platforms overlap."
    procedure_ids = "PA-P02,PA-P11,PA-P16"
    log_source_prerequisites = "AWS CloudTrail management events normalized with metadata.product_name = 'AWS CloudTrail', eventName in metadata.product_event_type, userIdentity ARN in principal.user.userid, userAgent in network.http.user_agent and requestParameters in additional.fields; eventSource in target.application."
    false_positives = "CSPM, inventory and governance roles."
    references = "reports/pacu/source-analysis.md#procedure-analysis; reviews/pacu/detection-review.md"
    validation_status = "needs_validation"
    validation_method = "Replay sanitized read events across 15 services from one ARN."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/pacu/detection-review.md"
  events:
    $e.metadata.product_name = "AWS CloudTrail"
    re.regex($e.metadata.product_event_type, `^(List|Describe|Get)[A-Z]`)
    not re.regex($e.network.http.user_agent, `(?i)(console\.amazonaws\.com|signin\.amazonaws\.com|AWS Internal)`)
    $e.principal.user.userid = $principal
    $e.target.application = $service
  match:
    $principal over 30m
  outcome:
    $services = count_distinct($service)
  condition:
    $e and $services >= 15
}
