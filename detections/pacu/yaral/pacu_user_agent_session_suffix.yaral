rule pacu_user_agent_session_suffix {
  meta:
    author = "Detection Research Agent"
    description = "Detects AWS API calls whose user agent carries Pacu's session suffix (Pacu-Session-<uuid>), appended by the set_ua_suffix command."
    date = "2026-11-21"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "The suffix is generated by the tool for attribution and appears verbatim in CloudTrail; it is present only when the operator enables it."
    procedure_ids = "PA-P01"
    log_source_prerequisites = "AWS CloudTrail management events normalized with metadata.product_name = 'AWS CloudTrail', eventName in metadata.product_event_type, userIdentity ARN in principal.user.userid, userAgent in network.http.user_agent and requestParameters in additional.fields."
    false_positives = "Authorized assessments that set the suffix deliberately for deconfliction."
    references = "reports/pacu/source-analysis.md#procedure-analysis; reviews/pacu/detection-review.md"
    validation_status = "needs_validation"
    validation_method = "Replay a sanitized CloudTrail event with the suffix in userAgent."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/pacu/detection-review.md"
  events:
    $e.metadata.product_name = "AWS CloudTrail"
    re.regex($e.network.http.user_agent, `Pacu-Session-[0-9a-fA-F-]{36}`)
    $e.principal.user.userid = $principal
  match:
    $principal over 1h
  outcome:
    $events = count($e.metadata.id)
    $event_names = array_distinct($e.metadata.product_event_type)
  condition:
    $e
}
