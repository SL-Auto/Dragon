// source_yaral: detections/pacu/yaral/pacu_sns_topic_subscription_fanout.yaral
// translation_status: experimental_needs_backend_mapping_and_validation
// fidelity: partial
// rule_name: pacu_sns_topic_subscription_fanout
// severity: medium
// procedure_ids: PA-P12
// description: Detects one principal subscribing endpoints to three or more SNS topics within 30 minutes.
// log_source_prerequisites: AWS CloudTrail management events normalized with metadata.product_name = 'AWS CloudTrail', eventName in metadata.product_event_type, userIdentity ARN in principal.user.userid, userAgent in network.http.user_agent and requestParameters in additional.fields; topicArn in target.resource.name.
// false_positives: Monitoring onboarding that subscribes to many topics.
// references: reports/pacu/source-analysis.md#procedure-analysis; reviews/pacu/detection-review.md
// schema_profile: schemas/elastic-ecs.yml
// field_mapping: normalized columns (product_name, product_event_type, principal_arn, event_source, source_ip, user_agent, resource_name); EQL uses ECS equivalents; enrichment columns map from UDM additional.fields / labels of the same name
// assumptions_and_gaps: EQL selects matching events but cannot aggregate; implement the grouping threshold in ES|QL or a threshold rule.
any where labels.product_name == "AWS CloudTrail"
  and event.code == "Subscribe"
