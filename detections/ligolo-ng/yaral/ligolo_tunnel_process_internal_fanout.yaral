rule ligolo_tunnel_process_internal_fanout {
  meta:
    author = "Detection Research Agent"
    description = "Detects one process that holds an outbound connection to a non-internal destination (the tunnel) while connecting to many distinct internal or loopback destinations or ports, which is the host effect of a pivot agent relaying operator traffic and scans into the network."
    date = "2026-11-21"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "The agent completes every relayed dial itself, so pivoting and tunnelled scans appear as one process fanning out to internal destinations while also holding external egress. This is independent of tool names and close to the security effect (network access from the compromised host)."
    procedure_ids = "LG-P01,LG-P04,LG-P05"
    log_source_prerequisites = "Process-attributed NETWORK_CONNECTION telemetry (Sysmon Event ID 3 or EDR equivalent) with direction, destination IP and port, host and a stable process ID; optional signature verification status for triage."
    false_positives = "Unsigned or unverified browsers, collaboration clients, management agents, vulnerability scanners and backup software that combine internet egress with broad internal connectivity. Verified-signed images are excluded; the exclusion fails open when signature enrichment is absent (LG-DR-02)."
    references = "reports/ligolo-ng/source-analysis.md#procedure-analysis; reviews/ligolo-ng/detection-review.md"
    validation_status = "needs_validation"
    validation_method = "Replay sanitized flow fixtures of one process with external egress plus ten or more internal destinations or ports, and baseline approved scanners and agents before enabling."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/ligolo-ng/detection-review.md"
  events:
    $up.metadata.event_type = "NETWORK_CONNECTION"
    $up.network.direction = "OUTBOUND"
    $up.principal.hostname = $host
    $up.principal.process.product_specific_process_id = $pid
    not net.ip_in_range_cidr($up.target.ip, "10.0.0.0/8")
    not net.ip_in_range_cidr($up.target.ip, "172.16.0.0/12")
    not net.ip_in_range_cidr($up.target.ip, "192.168.0.0/16")
    not net.ip_in_range_cidr($up.target.ip, "127.0.0.0/8")
    not net.ip_in_range_cidr($up.target.ip, "169.254.0.0/16")
    not net.ip_in_range_cidr($up.target.ip, "fc00::/7")
    not net.ip_in_range_cidr($up.target.ip, "::1/128")
    $up.principal.process.file.signature_info.verification_status != "VERIFIED"

    $in.metadata.event_type = "NETWORK_CONNECTION"
    $in.network.direction = "OUTBOUND"
    $in.principal.hostname = $host
    $in.principal.process.product_specific_process_id = $pid
    (
      net.ip_in_range_cidr($in.target.ip, "10.0.0.0/8") or
      net.ip_in_range_cidr($in.target.ip, "172.16.0.0/12") or
      net.ip_in_range_cidr($in.target.ip, "192.168.0.0/16") or
      net.ip_in_range_cidr($in.target.ip, "127.0.0.0/8") or
      net.ip_in_range_cidr($in.target.ip, "fc00::/7") or
      net.ip_in_range_cidr($in.target.ip, "::1/128")
    )
  match:
    $host, $pid over 15m
  outcome:
    $internal_destinations = count_distinct($in.target.ip)
    $internal_ports = count_distinct($in.target.port)
    $upstream = array_distinct($up.target.ip)
    $process = array_distinct($up.principal.process.file.full_path)
    $signature = array_distinct($up.principal.process.file.signature_info.verification_status)
  condition:
    $up and $in and ($internal_destinations >= 10 or $internal_ports >= 10)
}
