rule havoc_listener_and_forwarding {
  meta:
    author = "Detection Research Agent"
    description = "A process listens locally and also establishes outbound connections consistent with forwarding"
    date = "2026-08-15"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Bidirectional listener and egress behavior is a durable forwarding effect"
    procedure_ids = "HV-P16"
    log_source_prerequisites = "EDR socket listen and connect telemetry with stable process identity and direction"
    false_positives = "Approved proxies, VPNs, developer tunnels and network services"
    references = "reports/havoc/source-analysis.md"
    validation_status = "needs_validation"
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/havoc/detection-review.md"
  events:
    $l.metadata.product_event_type = "NETWORK_LISTEN"
    $l.principal.hostname = $host
    $l.principal.process.product_specific_process_id = $pid

    $n.metadata.event_type = "NETWORK_CONNECTION"
    $n.network.direction = "OUTBOUND"
    $n.principal.hostname = $host
    $n.principal.process.product_specific_process_id = $pid
  match:
    $host, $pid over 10m
  condition:
    $l and $n
}
