rule havoc_recurrent_process_egress {
  meta:
    author = "Detection Research Agent"
    description = "A process produces recurrent outbound network activity consistent with a long-lived task channel"
    date = "2026-08-15"
    status = "experimental"
    severity = "MEDIUM"
    severity_rationale = "Recurrent process-attributed egress is useful C2 context but common in legitimate agents"
    procedure_ids = "HV-P01,HV-P03"
    log_source_prerequisites = "Process-attributed network telemetry with stable process entity and event timestamps"
    false_positives = "Monitoring, update, VPN, messaging and management agents"
    references = "reports/havoc/source-analysis.md"
    validation_status = "needs_validation"
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/havoc/detection-review.md"
  events:
    $n.metadata.event_type = "NETWORK_CONNECTION"
    $n.network.direction = "OUTBOUND"
    $n.principal.hostname = $host
    $n.principal.process.product_specific_process_id = $pid
  match:
    $host, $pid over 30m
  outcome:
    $connection_count = count($n.metadata.id)
    $active_minutes = count_distinct(timestamp.get_minute($n.metadata.event_timestamp.seconds))
  condition:
    $n and $connection_count >= 5 and $active_minutes >= 3
}
