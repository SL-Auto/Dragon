rule havoc_cleanup_after_network_activity {
  meta:
    author = "Detection Research Agent"
    description = "A process deletes a file or terminates shortly after outbound network activity"
    date = "2026-08-15"
    status = "experimental"
    severity = "MEDIUM"
    severity_rationale = "Cleanup linked to prior egress is useful context but overlaps installers and updaters"
    procedure_ids = "HV-P20"
    log_source_prerequisites = "EDR file deletion or process termination and process-attributed network telemetry with stable identity"
    false_positives = "Installers, updaters, temporary helpers and self-cleaning applications"
    references = "reports/havoc/source-analysis.md"
    validation_status = "needs_validation"
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/havoc/detection-review.md"
  events:
    re.regex($c.metadata.event_type, `^(FILE_DELETION|PROCESS_TERMINATION)$`)
    $c.principal.hostname = $host
    $c.principal.process.product_specific_process_id = $pid

    $n.metadata.event_type = "NETWORK_CONNECTION"
    $n.network.direction = "OUTBOUND"
    $n.principal.hostname = $host
    $n.principal.process.product_specific_process_id = $pid
  match:
    $host, $pid over 15m
  condition:
    $c and $n
}
