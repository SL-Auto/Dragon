rule havoc_named_pipe_network_context {
  meta:
    author = "Detection Research Agent"
    description = "A network-active process creates or connects to a named pipe"
    date = "2026-08-15"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Process-linked named-pipe and network activity covers SMB transport and pivot effects"
    procedure_ids = "HV-P02,HV-P15"
    log_source_prerequisites = "EDR or Sysmon named-pipe create/connect normalized with process network telemetry"
    false_positives = "Remote administration, software deployment, backup and clustered applications"
    references = "reports/havoc/source-analysis.md"
    validation_status = "needs_validation"
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/havoc/detection-review.md"
  events:
    re.regex($p.metadata.product_event_type, `^(17|18|NAMED_PIPE_CREATE|NAMED_PIPE_CONNECT)$`)
    $p.principal.hostname = $host
    $p.principal.process.product_specific_process_id = $pid

    $n.metadata.event_type = "NETWORK_CONNECTION"
    $n.principal.hostname = $host
    $n.principal.process.product_specific_process_id = $pid
  match:
    $host, $pid over 10m
  condition:
    $p and $n
}
