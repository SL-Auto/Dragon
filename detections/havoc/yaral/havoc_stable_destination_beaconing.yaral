rule havoc_stable_destination_beaconing {
  meta:
    author = "Detection Research Agent"
    description = "A process repeatedly connects to the same destination across multiple active minutes"
    date = "2026-08-15"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Same-process same-destination recurrence is more selective than destination-agnostic egress"
    procedure_ids = "HV-P01,HV-P03"
    log_source_prerequisites = "Process-attributed outbound network telemetry with stable process and destination identity"
    false_positives = "Monitoring, update, VPN, messaging and management agents with stable services"
    references = "reports/havoc/source-analysis.md; public-rules/comparisons/havoc/havoc_recurrent_process_egress.md"
    validation_status = "needs_validation"
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/havoc/detection-review.md"
  events:
    $n.metadata.event_type = "NETWORK_CONNECTION"
    $n.network.direction = "OUTBOUND"
    $n.principal.hostname = $host
    $n.principal.process.product_specific_process_id = $pid
    $n.target.ip = $destination
  match:
    $host, $pid, $destination over 30m
  outcome:
    $connection_count = count($n.metadata.id)
    $active_minutes = count_distinct(timestamp.get_minute($n.metadata.event_timestamp.seconds))
  condition:
    $n and $connection_count >= 8 and $active_minutes >= 4
}
