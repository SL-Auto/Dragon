rule havoc_file_activity_from_network_process {
  meta:
    author = "Detection Research Agent"
    description = "A network-active process performs file collection, staging, mutation or deletion"
    date = "2026-08-15"
    status = "experimental"
    severity = "MEDIUM"
    severity_rationale = "Correlates file effects with egress but benign networked applications frequently access files"
    procedure_ids = "HV-P06,HV-P07,HV-P08"
    log_source_prerequisites = "EDR file lifecycle and process-attributed network events sharing a stable process entity"
    false_positives = "Browsers, synchronization, backup, deployment and endpoint-management software"
    references = "reports/havoc/source-analysis.md"
    validation_status = "needs_validation"
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/havoc/detection-review.md"
  events:
    re.regex($f.metadata.event_type, `^(FILE_READ|FILE_CREATION|FILE_MODIFICATION|FILE_DELETION)$`)
    $f.principal.hostname = $host
    $f.principal.process.product_specific_process_id = $pid

    $n.metadata.event_type = "NETWORK_CONNECTION"
    $n.network.direction = "OUTBOUND"
    $n.principal.hostname = $host
    $n.principal.process.product_specific_process_id = $pid
  match:
    $host, $pid over 10m
  condition:
    $f and $n
}
