rule chisel_stdio_network_bridge {
  meta:
    author = "Detection Research Agent"
    description = "Detects a process with redirected standard handles that also establishes sustained outbound connectivity"
    date = "2026-08-15"
    status = "experimental"
    severity = "MEDIUM"
    severity_rationale = "Covers socketless local stdio bridging but handle telemetry and benign automation overlap"
    procedure_ids = "CH-P06"
    log_source_prerequisites = "EDR process handle or redirected stdio semantic telemetry and outbound network connections"
    false_positives = "Remote administration automation IDE terminals and container entrypoints"
    references = "reports/chisel/source-analysis.md"
    validation_status = "needs_validation"
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/chisel/detection-review.md"
  events:
    $h.metadata.product_event_type = "PROCESS_STDIO_REDIRECT"
    $h.principal.hostname = $host
    $h.principal.process.product_specific_process_id = $pid
    $n.metadata.event_type = "NETWORK_CONNECTION"
    $n.network.direction = "OUTBOUND"
    $n.principal.hostname = $host
    $n.principal.process.product_specific_process_id = $pid
  match:
    $host, $pid over 10m
  condition:
    $h and $n
}
