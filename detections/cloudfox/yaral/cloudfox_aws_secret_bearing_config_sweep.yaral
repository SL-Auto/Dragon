rule cloudfox_aws_secret_bearing_config_sweep {
  meta:
    author = "Detection Research Agent"
    description = "Detects one AWS principal reading three or more kinds of secret-bearing configuration within 30 minutes: instance user data, ECS task definitions, CodeBuild projects, CloudFormation templates or Lambda function configuration."
    date = "2026-11-21"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Each source can hold embedded credentials; sweeping several kinds in one window is credential harvesting rather than routine operations."
    procedure_ids = "CF-A05"
    log_source_prerequisites = "userAgent in network.http.user_agent (console traffic excluded, CF-DR-02); AWS CloudTrail management events normalized with metadata.product_name = 'AWS CloudTrail', eventName in metadata.product_event_type, eventSource in target.application, userIdentity ARN in principal.user.userid."
    false_positives = "Deployment pipelines and cloud-governance tools that read several configuration types; approve their role ARNs."
    references = "reports/cloudfox/source-analysis.md#procedure-analysis; reviews/cloudfox/detection-review.md"
    validation_status = "needs_validation"
    validation_method = "Replay sanitized events for three of the listed event names from one ARN and baseline pipeline roles."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/cloudfox/detection-review.md"
  events:
    $e.metadata.product_name = "AWS CloudTrail"
    $e.metadata.product_event_type = /^(DescribeInstanceAttribute|DescribeTaskDefinition|BatchGetProjects|GetTemplate|ListFunctions|GetFunctionConfiguration)$/
    not re.regex($e.network.http.user_agent, `(?i)(console\.amazonaws\.com|signin\.amazonaws\.com|AWS Internal)`)
    $e.principal.user.userid = $principal
    $e.metadata.product_event_type = $name
  match:
    $principal over 30m
  outcome:
    $kinds = count_distinct($name)
    $names = array_distinct($name)
  condition:
    $e and $kinds >= 3
}
