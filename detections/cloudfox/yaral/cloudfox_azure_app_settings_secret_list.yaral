rule cloudfox_azure_app_settings_secret_list {
  meta:
    author = "Detection Research Agent"
    description = "Detects one caller listing App Service or Function App application settings or connection strings (Microsoft.Web/sites/config/list/action) on two or more sites within 30 minutes."
    date = "2026-11-21"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "The list action returns secret values in clear text; doing it across several apps is credential harvesting."
    procedure_ids = "CF-Z04"
    log_source_prerequisites = "Azure Activity Log (administrative category) with operationName in metadata.product_event_type, caller in principal.user.userid and resourceId in target.resource.name."
    false_positives = "Deployment pipelines, App Service backup or migration tooling, and administrators using the portal configuration blade."
    references = "reports/cloudfox/source-analysis.md#procedure-analysis; reviews/cloudfox/detection-review.md"
    validation_status = "needs_validation"
    validation_method = "Replay sanitized Activity Log entries for the list action on two sites and baseline deployment identities."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/cloudfox/detection-review.md"
  events:
    re.regex($e.metadata.product_event_type, `(?i)^MICROSOFT\.WEB/SITES/(SLOTS/)?CONFIG/LIST/ACTION$`)
    $e.principal.user.userid = $caller
    $e.target.resource.name = $site
  match:
    $caller over 30m
  outcome:
    $sites = count_distinct($site)
    $source_ips = array_distinct($e.principal.ip)
  condition:
    $e and $sites >= 2
}
