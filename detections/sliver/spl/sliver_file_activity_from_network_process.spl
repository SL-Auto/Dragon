# source_yaral: detections/sliver/yaral/sliver_file_activity_from_network_process.yaral
# translation_status: experimental_needs_backend_mapping_and_validation
# fidelity: partial
# rule_name: sliver_file_activity_from_network_process
# severity: medium
# procedure_ids: PROC-007,PROC-008,PROC-009
# description: File read or mutation by an outbound-network process
# log_source_prerequisites: EDR file and network telemetry sharing stable PID
# false_positives: Sync, backup, browsers, package managers
# references: reports/sliver/source-analysis.md
# assumptions_and_gaps: Candidate retrieval is translated; canonical entity joins, ordering, windows, and cardinality must be implemented and tested in the target backend.
# schema_profile: schemas/splunk-cim.yml
index=<configured_index>
| where in(coalesce('metadata.product_event_type','metadata.event_type'), "FILE_CREATION", "FILE_DELETION", "FILE_MODIFICATION", "FILE_READ", "NETWORK_CONNECTION")
| eval canonical_rule="sliver_file_activity_from_network_process"
| stats count values('metadata.product_event_type') as observed_event_types by 'principal.hostname', 'principal.user.userid'
| where count > 0
