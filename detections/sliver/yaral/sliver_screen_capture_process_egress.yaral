rule sliver_screen_capture_process_egress {
  meta:
    author = "Detection Research Agent"
    description = "Tenant-normalized screen capture followed by same-process egress"
    date = "2026-08-15"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Links collection with transfer"
    procedure_ids = "PROC-014"
    log_source_prerequisites = "Verified EDR screen capture mapping and stable PID network telemetry"
    false_positives = "Conferencing, remote support, screenshot tools"
    references = "reports/sliver/source-analysis.md"
    validation_status = "needs_validation"
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/sliver/detection-review.md"
  events:
    $c.metadata.event_type = "USER_RESOURCE_ACCESS"
    $c.security_result.rule_name = "SCREEN_CAPTURE"
    $c.principal.hostname = $host
    $c.principal.process.product_specific_process_id = $pid

    $n.metadata.event_type = "NETWORK_CONNECTION"
    $n.network.direction = "OUTBOUND"
    $n.principal.hostname = $host
    $n.principal.process.product_specific_process_id = $pid
  match: $host, $pid over 5m
  condition: $c and $n
}
