rule sliver_remote_admin_sequence {
  meta:
    author = "Detection Research Agent"
    description = "Remote authentication followed by service or SSH execution on target, joined by logon/session identity"
    date = "2026-08-16"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Adding the logon/session identifier to the join key closes the review-identified gap that a bare host-plus-user join can associate unrelated administration on a busy host; the identifier is not required to match against the network event so the join still degrades gracefully when a tenant lacks session-ID propagation"
    procedure_ids = "PROC-020"
    log_source_prerequisites = "Authentication and service/SSH process events with target host, account, and logon/session identifier"
    false_positives = "Deployment, backup, authorized remote administration"
    references = "reports/sliver/source-analysis.md, public-rules/comparisons/sliver/sliver_remote_admin_sequence.md"
    validation_status = "needs_validation"
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/sliver/detection-review.md"
    source_comparison = "modified_from_unvalidated_proposal"
  events:
    $l.metadata.product_event_type = /(4624|sshd_auth_success)/
    $l.target.hostname = $host
    $l.target.user.userid = $user
    $l.network.session_id = $session

    $x.metadata.product_event_type = /(4697|7045|sshd_command)/
    $x.target.hostname = $host
    $x.principal.user.userid = $user
    $x.network.session_id = $session
  match: $host, $user, $session over 10m
  condition: $l and $x
}
