rule cobalt_strike_privileged_context_change {
  meta:
    author = "Detection Research Agent"
    description = "Surfaces special-privilege assignment or endpoint token-privilege modification by an uncommon process."
    date = "2026-08-15"
    status = "experimental"
    severity = "MEDIUM"
    severity_rationale = "Privilege changes provide context for follow-on activity but are frequent for services and security tools."
    procedure_ids = "CSB-011"
    log_source_prerequisites = "Normalize Windows 4672 or EDR TOKEN_PRIVILEGE_CHANGE with process, user, logon ID, privilege list and signer/prevalence."
    false_positives = "Services, installers, EDR, backup, forensic and administrative tools."
    references = "reports/cobalt-strike-beacon/source-analysis.md"
    validation_status = "needs_validation"
    validation_method = "Replay sanitized privilege events from legitimate services."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/cobalt-strike-beacon/detection-review.md"
  events:
    ($e.metadata.product_event_type = "4672" or $e.metadata.event_type = "TOKEN_PRIVILEGE_CHANGE")
    ($e.principal.process.file.is_signed = false or $e.principal.process.file.prevalence = "RARE")
  condition:
    $e
}
