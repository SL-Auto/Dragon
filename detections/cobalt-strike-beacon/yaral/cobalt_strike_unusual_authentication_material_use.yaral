rule cobalt_strike_unusual_authentication_material_use {
  meta:
    author = "Detection Research Agent"
    description = "Surfaces Kerberos or NTLM authentication whose endpoint/process context is rare or inconsistent with the account baseline."
    date = "2026-08-15"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Unexpected ticket/hash-backed authentication can indicate alternate authentication material use but requires identity baselining."
    procedure_ids = "CSB-013"
    log_source_prerequisites = "Normalize DC 4768/4769/4776 and endpoint 4624 with account, source, service, authentication package and identity-baseline enrichment."
    false_positives = "New hosts, password rotation, service migration, disaster recovery, legacy NTLM and identity infrastructure."
    references = "reports/cobalt-strike-beacon/source-analysis.md"
    validation_status = "needs_validation"
    validation_method = "Use sanitized authentication history and synthetic rare-source enrichment; never inject credentials or tickets."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/cobalt-strike-beacon/detection-review.md"
  events:
    ($e.metadata.product_event_type = "4768" or $e.metadata.product_event_type = "4769" or $e.metadata.product_event_type = "4776" or $e.metadata.product_event_type = "4624")
    $e.security_result.action = "ALLOW"
    $e.principal.asset.first_seen_hours < 24
  condition:
    $e
}
