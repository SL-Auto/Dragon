rule cobalt_strike_directory_discovery {
  meta:
    author = "Detection Research Agent"
    description = "Detects broad directory/RPC enumeration by one endpoint process across multiple object classes or operations."
    date = "2026-08-15"
    status = "experimental"
    severity = "MEDIUM"
    severity_rationale = "Broad domain discovery is valuable reconnaissance context but overlaps inventory and identity products."
    procedure_ids = "CSB-022"
    log_source_prerequisites = "Normalize LDAP_QUERY or RPC_CALL with client process/host/account and query object class/filter or interface operation."
    false_positives = "Identity governance, endpoint inventory, directory health, administration and vulnerability assessment."
    references = "reports/cobalt-strike-beacon/source-analysis.md"
    validation_status = "needs_validation"
    validation_method = "Use sanitized domain-inventory logs and synthetic query bursts."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/cobalt-strike-beacon/detection-review.md"
  events:
    ($e.metadata.event_type = "LDAP_QUERY" or $e.metadata.event_type = "RPC_CALL")
    $e.principal.hostname = $host
    $e.principal.process.entity_id = $process
    $e.target.resource.type = $object_type
  match:
    $host, $process over 10m
  condition:
    #object_type >= 4
}
