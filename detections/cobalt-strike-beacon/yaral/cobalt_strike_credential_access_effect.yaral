rule cobalt_strike_credential_access_effect {
  meta:
    author = "Detection Research Agent"
    description = "Detects LSASS access, protected credential-store access, or directory replication control access as credential-access effects."
    date = "2026-08-15"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "These effects can expose reusable credentials, but authorized security, backup and identity systems overlap."
    procedure_ids = "CSB-028"
    log_source_prerequisites = "Normalize Sysmon 10/EDR LSASS access, sensitive store reads, or DC 4662 replication-right events with actor/process/source and target details."
    false_positives = "EDR, antivirus, backup, forensics, identity sync, migration and directory recovery."
    references = "reports/cobalt-strike-beacon/source-analysis.md"
    validation_status = "needs_validation"
    validation_method = "Replay sanitized vendor and identity fixtures; never read credentials or LSASS."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/cobalt-strike-beacon/detection-review.md"
  events:
    ($e.metadata.event_type = "LSASS_PROCESS_ACCESS" or $e.metadata.event_type = "CREDENTIAL_STORE_READ" or ($e.metadata.product_event_type = "4662" and re.regex($e.security_result.description, `(?i)(Replicating Directory Changes|DS-Replication-Get-Changes|1131f6a[a-d])`)))
  condition:
    $e
}
