rule cobalt_strike_cross_process_injection {
  meta:
    author = "Detection Research Agent"
    description = "Detects cross-process access followed by remote thread or executable-memory activity in the same target process."
    date = "2026-08-15"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Cross-process memory manipulation is a strong injection signal, although security and diagnostic tools can match."
    procedure_ids = "CSB-018,CSB-019"
    log_source_prerequisites = "Normalize Sysmon 8/10 or EDR PROCESS_OPEN, REMOTE_THREAD and EXECUTABLE_MEMORY with stable source and target process entities."
    false_positives = "EDR, debuggers, accessibility tools, application instrumentation and authorized diagnostics."
    references = "reports/cobalt-strike-beacon/source-analysis.md"
    validation_status = "needs_validation"
    validation_method = "Replay vendor benign injection fixtures; never inject code."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/cobalt-strike-beacon/detection-review.md"
  events:
    $open.metadata.event_type = "PROCESS_OPEN"
    $open.principal.hostname = $host
    $open.principal.process.entity_id = $source
    $open.target.process.entity_id = $target
    $effect.principal.hostname = $host
    $effect.principal.process.entity_id = $source
    $effect.target.process.entity_id = $target
    ($effect.metadata.event_type = "REMOTE_THREAD" or $effect.metadata.event_type = "EXECUTABLE_MEMORY")
  match:
    $host, $source, $target over 2m
  condition:
    $open and $effect
}
