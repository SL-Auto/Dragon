rule cobalt_strike_powershell_or_clr_in_unusual_host {
  meta:
    author = "Detection Research Agent"
    description = "Detects PowerShell/CLR runtime initialization or script telemetry in a process not normally hosting that runtime."
    date = "2026-08-15"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Unmanaged PowerShell and in-memory assemblies can initialize runtimes in unusual hosts."
    procedure_ids = "CSB-015,CSB-017"
    log_source_prerequisites = "Normalize PowerShell 400/403/4103/4104, CLR load or EDR runtime initialization with host process and parser-provided expected-host enrichment."
    false_positives = "Custom .NET hosts, management agents, IDEs, installers and legitimate PowerShell embedding."
    references = "reports/cobalt-strike-beacon/source-analysis.md"
    validation_status = "needs_validation"
    validation_method = "Use sanitized PowerShell and approved custom CLR-host fixtures."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/cobalt-strike-beacon/detection-review.md"
  events:
    ($e.metadata.event_type = "POWERSHELL_SCRIPT" or $e.metadata.event_type = "CLR_RUNTIME_LOAD")
    $e.principal.process.runtime_expected = false
  condition:
    $e
}
