rule cobalt_strike_dns_process_context {
  meta:
    author = "Detection Research Agent"
    description = "Detects sustained process-attributed DNS activity with long or high-entropy labels as a DNS C2 hypothesis."
    date = "2026-08-15"
    status = "experimental"
    severity = "MEDIUM"
    severity_rationale = "Encoded DNS tasking may create repeated unusual queries, but many security and cloud products do likewise."
    procedure_ids = "CSB-006"
    log_source_prerequisites = "Normalize DNS_QUERY with process entity, query name/type, host and parser-provided query-label entropy or length."
    false_positives = "CDNs, endpoint security, telemetry agents, anti-abuse services and DNS-based service discovery."
    references = "reports/cobalt-strike-beacon/source-analysis.md"
    validation_status = "needs_validation"
    validation_method = "Use fabricated DNS records with benign and encoded-label distributions."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/cobalt-strike-beacon/detection-review.md"
  events:
    $e.metadata.event_type = "DNS_QUERY"
    $e.principal.hostname = $host
    $e.principal.process.file.full_path = $process
    ($e.network.dns.questions.name.length > 55 or $e.network.dns.questions.name_entropy > 3.8)
  match:
    $host, $process over 20m
  condition:
    #e >= 8
}
