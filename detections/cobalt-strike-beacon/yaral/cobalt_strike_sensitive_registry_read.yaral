rule cobalt_strike_sensitive_registry_read {
  meta:
    author = "Detection Research Agent"
    description = "Surfaces registry read/enumeration of security-sensitive configuration by an uncommon process."
    date = "2026-08-15"
    status = "experimental"
    severity = "MEDIUM"
    severity_rationale = "Sensitive registry discovery may precede credential or environment abuse but legitimate management overlaps."
    procedure_ids = "CSB-023"
    log_source_prerequisites = "Normalize EDR REGISTRY_READ or scoped 4656/4663 with process, user, hive/key/value, operation and sensitivity classification."
    false_positives = "Inventory, compliance, EDR, backup, forensics and operating-system components."
    references = "reports/cobalt-strike-beacon/source-analysis.md"
    validation_status = "needs_validation"
    validation_method = "Use benign reads of non-secret test keys and synthetic sensitivity labels."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/cobalt-strike-beacon/detection-review.md"
  events:
    $e.metadata.event_type = "REGISTRY_READ"
    $e.target.resource.sensitivity = "HIGH"
    ($e.principal.process.file.is_signed = false or $e.principal.process.file.prevalence = "RARE")
  condition:
    $e
}
