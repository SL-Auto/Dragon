rule mimikatz_account_secret_change {
 meta:
  author = "Detection Research Agent"
  description = "Detects account or machine-account secret changes for contextual correlation."
  date = "2026-08-15"
  status = "experimental"
  severity = "MEDIUM"
  severity_rationale = "Unexpected credential reset can follow SAMR or Netlogon manipulation."
  procedure_ids = "P16"
  log_source_prerequisites = "DC Security 4723, 4724 and 4742 with caller, target and source context."
  false_positives = "Helpdesk resets, machine password rotation and authorized recovery."
  references = "reports/mimikatz/source-analysis.md"
  validation_status = "needs_validation"
  review_status = "reviewed_with_gaps"
  review_reference = "reviews/mimikatz/detection-review.md"
 events:
  re.regex($e.metadata.product_event_type, `^(4723|4724|4742)$`)
 condition:
  $e
}
