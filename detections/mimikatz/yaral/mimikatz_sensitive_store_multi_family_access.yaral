rule mimikatz_sensitive_store_multi_family_access {
  meta:
    author = "Detection Research Agent"
    description = "Correlates one process reading two independent sensitive-store families (credential manager/Vault versus crypto/certificate/Hello, IIS, SCCM/Citrix or RDM stores) as a stronger compensating signal for broad single-path store access."
    date = "2026-08-16"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "A single process reading multiple independent credential-store families in one session is materially less common than a single path read and better approximates automated multi-source credential collection than the broad atomic rule alone."
    procedure_ids = "P18,P19,P20,P23,P25,P37,P41,P46"
    log_source_prerequisites = "EDR sensitive file or registry read telemetry with process, host and user identity, sufficient to distinguish at least two of: Credential Manager/Vault; DPAPI/crypto/certificate/Hello key stores; IIS configuration; SCCM/VSS/Citrix; Remote Desktop Manager."
    false_positives = "Backup, migration, credential-manager, endpoint-security and IT-provisioning tools that legitimately enumerate more than one store family in a session."
    references = "reports/mimikatz/source-analysis.md; public-rules/comparisons/mimikatz/mimikatz_sensitive_store_access.md"
    validation_status = "needs_validation"
    validation_method = "Replay sanitized fixtures for both a genuine multi-family attacker sequence and known-legitimate multi-family sessions (backup/migration/browser sync) before enabling with any active response."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/mimikatz/detection-review.md"

  events:
    ($a.metadata.event_type = "FILE_READ" or $a.metadata.event_type = "REGISTRY_READ")
    $a.principal.hostname = $host
    $a.principal.process.product_specific_process_id = $pid
    $a.principal.user.userid = $user
    re.regex($a.target.resource.name, `(?i)(Protect\\|Credentials|Vault)`)

    ($b.metadata.event_type = "FILE_READ" or $b.metadata.event_type = "REGISTRY_READ")
    $b.principal.hostname = $host
    $b.principal.process.product_specific_process_id = $pid
    $b.principal.user.userid = $user
    re.regex($b.target.resource.name, `(?i)(Crypto\\|RSA\\|Keys\\|Ngc|applicationHost\.config|SCCM|Citrix|Remote.?Desktop.?Manager)`)

  match:
    $host, $pid, $user over 15m

  condition:
    $a and $b
}
