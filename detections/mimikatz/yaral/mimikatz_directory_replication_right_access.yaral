rule mimikatz_directory_replication_right_access {
  meta:
    author = "Detection Research Agent"
    description = "Detects directory replication extended-right access for contextual triage; approved DC and sync context must be applied as narrow downstream enrichment."
    date = "2026-08-15"
    status = "experimental"
    severity = "HIGH"
    severity_rationale = "Replication rights can disclose domain credential material, but legitimate DC and identity-sync activity must be distinguished with verified context."
    procedure_ids = "P14"
    log_source_prerequisites = "Normalize domain-controller Security Event ID 4662 with subject, source host, object, access mask, and replication-right GUIDs."
    false_positives = "Approved identity synchronization, migration, backup, recovery, and directory-health products."
    references = "reports/mimikatz/source-analysis.md; https://learn.microsoft.com/previous-versions/windows/it-pro/windows-10/security/threat-protection/auditing/event-4662"
    validation_status = "needs_validation"
    validation_method = "Use sanitized legitimate replication records and synthetic non-DC fixtures; never access production credentials."
    review_status = "reviewed_with_gaps"
    review_reference = "reviews/mimikatz/detection-review.md"

  events:
    $e.metadata.product_event_type = "4662"
    re.regex($e.security_result.description, `(?i)(DS-Replication-Get-Changes|Replicating Directory Changes|1131f6a[a-d]-9c07-11d1-f79f-00c04fc2dcd2)`)

  condition:
    $e
}
