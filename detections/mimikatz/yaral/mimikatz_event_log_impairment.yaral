rule mimikatz_event_log_impairment {
 meta:
  author = "Detection Research Agent"
  description = "Detects log clearing or endpoint telemetry reporting Event Log service tampering."
  date = "2026-08-15"
  status = "experimental"
  severity = "HIGH"
  severity_rationale = "Log impairment removes defensive evidence."
  procedure_ids = "P26"
  log_source_prerequisites = "Forwarded Security 1102, System 104 or EDR service-tamper telemetry."
  false_positives = "Authorized log maintenance and lab reset."
  references = "reports/mimikatz/source-analysis.md"
  validation_status = "needs_validation"
  review_status = "reviewed_with_gaps"
  review_reference = "reviews/mimikatz/detection-review.md"
 events:
  (re.regex($e.metadata.product_event_type, `^(1102|104)$`) or re.regex($e.security_result.description, `(?i)(eventlog.*tamper)`))
 condition:
  $e
}
