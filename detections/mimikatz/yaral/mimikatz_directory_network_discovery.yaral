rule mimikatz_directory_network_discovery {
 meta:
  author = "Detection Research Agent"
  description = "Surfaces high-volume LDAP or RPC discovery reported by network or endpoint sensors."
  date = "2026-08-15"
  status = "experimental"
  severity = "LOW"
  severity_rationale = "Discovery is common but can add context to credential-access chains."
  procedure_ids = "P30"
  log_source_prerequisites = "LDAP, RPC or EDR discovery telemetry with process, account, destination and operation."
  false_positives = "Inventory, identity, monitoring and administration tools."
  references = "reports/mimikatz/source-analysis.md"
  validation_status = "needs_validation"
  review_status = "reviewed_with_gaps"
  review_reference = "reviews/mimikatz/detection-review.md"
 events:
  re.regex($e.security_result.description, `(?i)(ldap.*search|netapi.*enumerat|trust.*enumerat)`)
 condition: $e
}
