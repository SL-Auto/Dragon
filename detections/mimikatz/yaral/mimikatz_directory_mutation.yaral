rule mimikatz_directory_mutation {
 meta:
  author = "Detection Research Agent"
  description = "Detects directory replication, SIDHistory or identity-attribute mutation requiring source-host triage."
  date = "2026-08-15"
  status = "experimental"
  severity = "HIGH"
  severity_rationale = "Unexpected replication or identity attribute change can establish durable privilege."
  procedure_ids = "P15,P29"
  log_source_prerequisites = "Domain controller 4662 and 5136 events normalized with subject, object, attribute and source."
  false_positives = "Approved domain promotion, identity migration and directory administration."
  references = "reports/mimikatz/source-analysis.md"
  validation_status = "needs_validation"
  review_status = "reviewed_with_gaps"
  review_reference = "reviews/mimikatz/detection-review.md"
 events:
  ($e.metadata.product_event_type = "5136" or $e.metadata.product_event_type = "4662")
  re.regex($e.security_result.description, `(?i)(sIDHistory|servicePrincipalName|replicat|nTDSDSA)`)
 condition:
  $e
}
