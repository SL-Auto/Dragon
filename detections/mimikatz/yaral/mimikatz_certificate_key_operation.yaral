rule mimikatz_certificate_key_operation {
 meta:
  author = "Detection Research Agent"
  description = "Surfaces certificate enrollment, private-key export or Hello key operations."
  date = "2026-08-15"
  status = "experimental"
  severity = "MEDIUM"
  severity_rationale = "Unexpected authentication certificate or private-key use can enable impersonation."
  procedure_ids = "P21,P24"
  log_source_prerequisites = "AD CS, CAPI2, Hello, TPM or EDR key-operation telemetry."
  false_positives = "Normal enrollment, renewal, signing and device provisioning."
  references = "reports/mimikatz/source-analysis.md"
  validation_status = "needs_validation"
  review_status = "reviewed_with_gaps"
  review_reference = "reviews/mimikatz/detection-review.md"
 events:
  (re.regex($e.metadata.product_event_type, `^(4886|4887)$`) or re.regex($e.security_result.description, `(?i)(private.key.*export|hello.*(sign|decrypt))`))
 condition: $e
}
