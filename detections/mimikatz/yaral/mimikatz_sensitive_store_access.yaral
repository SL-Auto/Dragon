rule mimikatz_sensitive_store_access {
 meta:
  author = "Detection Research Agent"
  description = "Detects one process reading credential, key, DPAPI, IIS, SCCM, Citrix, browser or RDM stores."
  date = "2026-08-15"
  status = "experimental"
  severity = "MEDIUM"
  severity_rationale = "Novel multi-store reads can indicate credential collection but require application context."
  procedure_ids = "P18,P19,P20,P23,P25,P37,P41,P46"
  log_source_prerequisites = "EDR sensitive file or registry read telemetry with process and target path."
  false_positives = "Backup, migration, inventory, browser, credential management and endpoint security software."
  references = "reports/mimikatz/source-analysis.md"
  validation_status = "needs_validation"
  review_status = "reviewed_with_gaps"
  review_reference = "reviews/mimikatz/detection-review.md"
 events:
  ($e.metadata.event_type = "FILE_READ" or $e.metadata.event_type = "REGISTRY_READ")
  re.regex($e.target.resource.name, `(?i)(Protect\\|Credentials|Vault|Crypto\\|RSA\\|Keys\\|Ngc\\|applicationHost\.config|SCCM|Citrix|Remote.?Desktop.?Manager)`)
 condition:
  $e
}
